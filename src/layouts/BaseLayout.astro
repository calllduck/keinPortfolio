---
// BaseLayout: the page shell every page uses.
// Imports the font (self-hosted) + global styles so design tokens
// are available everywhere.
// Display font (headings/brand)
import "@fontsource/space-grotesk/400.css";
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/700.css";
// Body font (paragraphs/UI) — more legible for reading
import "@fontsource/inter/300.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/700.css";
import "../styles/global.css";
import Lightbox from "../components/Lightbox.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
// CvModal (multi-CV popup) kept as a backup. To re-enable:
//   1. uncomment the import below
//   2. uncomment <CvModal /> near </body>
//   3. switch the "View my CV" buttons back to <button data-cv-open>
// import CvModal from "../components/CvModal.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Portfolio",
  description = "Personal portfolio.",
} = Astro.props;

// Prefix public assets with the configured base so they resolve
// correctly on GitHub Pages (base: "/KeinPortofolio").
const base = import.meta.env.BASE_URL;
// Ensure exactly one slash between base and the asset path.
const favicon = `${base.replace(/\/$/, "")}/favicon.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <Lightbox />
    <ScrollReveal />
    {/* <CvModal /> */}
  </body>
</html>
