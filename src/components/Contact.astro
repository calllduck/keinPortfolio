---
// Contact: a message form (submitted to Formspree) + social icons.
//
// FORMSPREE SETUP:
//   1. In your Formspree dashboard, create a form -> you get an
//      endpoint like https://formspree.io/f/abcdwxyz
//   2. Put the ID part ("abcdwxyz") into `formId` below (or pass it
//      as a prop: <Contact formId="abcdwxyz" />).
// Until a real ID is set, the form stays disabled to avoid broken posts.
interface Props {
  email?: string;
  linkedin?: string;
  whatsapp?: string; // full wa.me link or phone
  github?: string;
  behance?: string;
  formId?: string; // Formspree form ID (the part after /f/)
}

const {
  email = "kettin@binus.ac.id",
  // Replace these with your real profiles:
  linkedin = "https://www.linkedin.com/in/your-handle",
  whatsapp = "https://wa.me/0000000000",
  github = "https://github.com/your-handle",
  behance = "https://www.behance.net/your-handle",
  // Formspree form ID (the part after /f/ in your endpoint).
  formId = "xvkzoeyg",
} = Astro.props;

const formAction = `https://formspree.io/f/${formId}`;
const formConfigured = formId !== "your-form-id";
---

<section id="contact" class="contact">
  <div class="container">
    <header class="contact__header">
      <h2 class="contact__title">Contact Me</h2>
      <p class="contact__subtitle">
        Have a question or want to work together? Send me a message.
      </p>
    </header>

    <!-- Message form (submitted to Formspree via fetch) -->
    <form
      class="contact-form"
      data-contact-form
      action={formAction}
      method="POST"
    >
        <div class="field">
          <label class="field__label" for="cf-name">Name</label>
          <input
            class="field__input"
            id="cf-name"
            name="name"
            type="text"
            placeholder="Your name"
            required
          />
        </div>

        <div class="field">
          <label class="field__label" for="cf-email">Your email</label>
          <input
            class="field__input"
            id="cf-email"
            name="email"
            type="email"
            placeholder="you@example.com"
            required
          />
        </div>

        <div class="field">
          <label class="field__label" for="cf-message">Message</label>
          <textarea
            class="field__input field__textarea"
            id="cf-message"
            name="message"
            rows="5"
            placeholder="Write your message…"
            required></textarea>
        </div>

        <button class="btn btn--lg btn--fill" type="submit">
          Send Message
        </button>

        <!-- Status messages (shown after submit) -->
        <p class="contact-form__status" data-status role="status" hidden></p>

        {
          !formConfigured && (
            <p class="contact-form__note">
              ⚠ Form not connected yet — set your Formspree ID in
              <code>src/components/Contact.astro</code> (the <code>formId</code>).
            </p>
          )
        }
      </form>

    <!-- Social / direct links: compact clickable icons, below the form -->
    <p class="contact__socials-label">Or find me on</p>
    <aside class="contact__socials" aria-label="Other ways to reach me">
        <a
          class="social"
          href={linkedin}
          target="_blank"
          rel="noopener"
          aria-label="LinkedIn"
          title="LinkedIn"
        >
          <svg class="social__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"
            ></path>
          </svg>
        </a>

        <a
          class="social"
          href={whatsapp}
          target="_blank"
          rel="noopener"
          aria-label="WhatsApp"
          title="WhatsApp"
        >
          <svg class="social__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M17.5 14.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.88 1.21 3.08.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35zM12.05 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5A9.43 9.43 0 0 1 18.7 5.3a9.37 9.37 0 0 1 2.76 6.67 9.43 9.43 0 0 1-9.42 9.53zM20.52 3.45A11.76 11.76 0 0 0 12.05 0C5.5 0 .16 5.33.16 11.89c0 2.1.55 4.14 1.6 5.95L.05 24l6.33-1.66a11.86 11.86 0 0 0 5.67 1.44h.01c6.55 0 11.89-5.33 11.89-11.89 0-3.18-1.24-6.17-3.48-8.44z"
            ></path>
          </svg>
        </a>

        <a
          class="social"
          href={github}
          target="_blank"
          rel="noopener"
          aria-label="GitHub"
          title="GitHub"
        >
          <svg class="social__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.75.4-1.27.73-1.56-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"
            ></path>
          </svg>
        </a>

        <a
          class="social"
          href={behance}
          target="_blank"
          rel="noopener"
          aria-label="Behance"
          title="Behance"
        >
          <svg class="social__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M9.3 7.9c.6 0 1.14.05 1.63.16.49.1.9.28 1.25.52.34.24.6.56.79.96.18.4.27.9.27 1.48 0 .64-.14 1.17-.43 1.6-.3.42-.72.77-1.3 1.04.78.22 1.37.62 1.75 1.18.39.57.58 1.25.58 2.05 0 .64-.13 1.2-.37 1.67-.25.47-.59.86-1.01 1.16-.42.3-.9.52-1.46.66-.55.14-1.12.2-1.7.2H2V7.9h7.3zm-.44 4.84c.48 0 .88-.11 1.19-.35.3-.23.46-.6.46-1.12 0-.29-.05-.52-.16-.7a1.1 1.1 0 0 0-.42-.42 1.73 1.73 0 0 0-.6-.2c-.23-.04-.47-.05-.72-.05H5.2v2.84h3.66zm.2 5.08c.27 0 .53-.03.77-.08.24-.05.46-.14.64-.26.19-.13.33-.3.44-.52.11-.21.16-.49.16-.83 0-.66-.19-1.13-.56-1.42-.37-.28-.86-.42-1.47-.42H5.2v3.55h3.86zM16.4 17.9c.35.34.86.51 1.52.51.47 0 .88-.12 1.22-.36.34-.23.55-.49.63-.75h2.3c-.37 1.14-.94 1.96-1.7 2.45-.76.5-1.68.74-2.76.74-.75 0-1.43-.12-2.03-.36a4.26 4.26 0 0 1-2.46-2.6 5.6 5.6 0 0 1-.34-2c0-.7.12-1.35.35-1.95.23-.6.56-1.12.98-1.56.42-.44.93-.78 1.51-1.03a5 5 0 0 1 1.99-.38c.8 0 1.5.16 2.1.47.6.3 1.09.72 1.47 1.24.38.52.65 1.12.82 1.78.16.67.22 1.36.17 2.09h-6.33c0 .67.23 1.31.57 1.65zM19.1 9.2h-4.4V7.7h4.4v1.5zm-.5 4.1a1.9 1.9 0 0 0-.49-.76c-.3-.3-.74-.45-1.33-.45-.38 0-.7.07-.95.2-.26.12-.46.28-.62.47-.15.19-.26.39-.32.6-.06.21-.1.4-.11.57h3.9c-.03-.5-.12-.9-.28-1.19z"
            ></path>
          </svg>
        </a>

        <a
          class="social"
          href={`mailto:${email}`}
          aria-label={`Email ${email}`}
          title={email}
        >
          <svg class="social__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4.24-8 4.76-8-4.76V6l8 4.76L20 6v2.24z"
            ></path>
          </svg>
        </a>
      </aside>
  </div>

  <!-- Decorative double squircle, placed OUTSIDE the container so it
       isn't constrained by its max-width/padding. Pinned to the
       section's bottom-right and clipped by the section's overflow. -->
  <div class="contact__decor" aria-hidden="true">
    <span class="contact__blob contact__blob--a"></span>
    <span class="contact__blob contact__blob--b"></span>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden; /* clips the decor at the real section edges */
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  /* Keep the form/content above the decorative shapes. */
  .contact > .container {
    position: relative;
    z-index: 1;
  }

  .contact__header {
    margin-bottom: var(--space-xl);
  }

  .contact__title {
    font-size: var(--fs-2xl);
  }

  .contact__subtitle {
    margin-top: var(--space-xs);
    font-weight: var(--fw-light);
    color: var(--color-text-muted);
    max-width: 52ch;
  }

  /* ---------- Form ---------- */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 560px;
  }

  /* ---------- Decorative double squircle ----------
     Pinned to the section's bottom-right corner (outside the
     container, so no max-width/padding "cage"). Negative offsets push
     them past the edge; the section's overflow:hidden clips them. */
  .contact__decor {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 560px;
    height: 560px;
    pointer-events: none;
    z-index: 0;
    display: none; /* hidden on small screens */
  }

  @media (min-width: 900px) {
    .contact__decor {
      display: block;
    }
  }

  .contact__blob {
    position: absolute;
    border: 2px solid var(--color-accent);
    pointer-events: none;
  }

  /* Big outline squircle, pushed past the bottom-right corner. */
  .contact__blob--a {
    width: 560px;
    height: 560px;
    right: -170px;
    bottom: -170px;
    opacity: 0.45;
    border-radius: 42% 58% 60% 40% / 50% 45% 55% 50%;
    animation: contact-morph-a 14s ease-in-out infinite;
  }

  /* Second squircle — smaller, offset only a little so the two
     overlap heavily, with different timing + phase. */
  .contact__blob--b {
    width: 420px;
    height: 420px;
    right: -130px;
    bottom: -130px;
    opacity: 0.22;
    border-radius: 55% 45% 42% 58% / 48% 60% 40% 52%;
    animation: contact-morph-b 9.5s ease-in-out infinite;
    animation-delay: -3.5s;
  }

  @keyframes contact-morph-a {
    0%,
    100% {
      border-radius: 42% 58% 60% 40% / 50% 45% 55% 50%;
    }
    33% {
      border-radius: 58% 42% 45% 55% / 60% 50% 50% 40%;
    }
    66% {
      border-radius: 48% 52% 55% 45% / 42% 58% 42% 58%;
    }
  }

  @keyframes contact-morph-b {
    0%,
    100% {
      border-radius: 55% 45% 42% 58% / 48% 60% 40% 52%;
    }
    50% {
      border-radius: 40% 60% 58% 42% / 55% 42% 58% 45%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__blob {
      animation: none;
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .field__label {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }

  .field__input {
    font-family: var(--font-sans);
    font-size: var(--fs-base);
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.7em 0.9em;
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .field__input::placeholder {
    color: var(--color-text-faint);
  }

  .field__input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-ring);
  }

  .field__textarea {
    resize: vertical;
    min-height: 120px;
  }

  .contact-form__note {
    font-size: var(--fs-xs);
    font-weight: var(--fw-light);
    color: var(--color-text-faint);
    margin: 0;
  }

  .contact-form__note code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-text-muted);
  }

  .contact-form__status {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    margin: 0;
  }

  /* Success vs error coloring */
  .contact-form__status[data-ok="true"] {
    color: var(--color-accent);
  }

  .contact-form__status[data-ok="false"] {
    color: #ff6b6b;
  }

  /* ---------- Socials: compact square-rounded icons, below form ---------- */
  .contact__socials-label {
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-sm);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
  }

  .contact__socials {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-content: flex-start;
  }

  .social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md); /* square with soft rounding */
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .social:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow);
  }

  .social__icon {
    width: 20px;
    height: 20px;
  }
</style>

<script>
  // Submit the form to Formspree via fetch (AJAX) so the page doesn't
  // navigate away, and show a success / error message inline.
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const status = document.querySelector<HTMLElement>("[data-status]");

  const show = (msg: string, ok: boolean) => {
    if (!status) return;
    status.textContent = msg;
    status.hidden = false;
    status.dataset.ok = String(ok);
  };

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const action = form.getAttribute("action") ?? "";
      // Guard: don't post to the placeholder endpoint.
      if (action.endsWith("/your-form-id")) {
        show("Form isn't connected yet. Add your Formspree ID.", false);
        return;
      }

      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (btn) btn.disabled = true;

      try {
        const res = await fetch(action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });

        if (res.ok) {
          form.reset();
          show("Thanks! Your message has been sent.", true);
        } else {
          show("Something went wrong. Please try again later.", false);
        }
      } catch {
        show("Network error. Please try again later.", false);
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  }
</script>
