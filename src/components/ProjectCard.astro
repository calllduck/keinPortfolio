---
// ProjectCard: a single project tile. Reused for every project so
// they stay perfectly consistent — content comes in via props.
interface ProjectLink {
  label: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  tags?: string[];
  href?: string; // live/demo link (shorthand)
  repo?: string; // source code link (shorthand)
  hrefLabel?: string; // custom text for the live link (default "Live")
  repoLabel?: string; // custom text for the repo link (default "Code")
  links?: ProjectLink[]; // any number of extra custom links
  image?: string; // path under /public (optional)
}

import ZoomableImage from "./ZoomableImage.astro";

const base = import.meta.env.BASE_URL;
const {
  title,
  description,
  tags = [],
  href,
  repo,
  hrefLabel = "Live",
  repoLabel = "Code",
  links = [],
  image,
} = Astro.props;
const imageSrc = image ? `${base.replace(/\/$/, "")}/${image}` : undefined;

// Combine shorthand href/repo with the flexible `links` array into
// one list, so a card can show any number of links.
const allLinks: ProjectLink[] = [
  ...(href ? [{ label: hrefLabel, url: href }] : []),
  ...(repo ? [{ label: repoLabel, url: repo }] : []),
  ...links,
];
---

<article class="card">
  {
    imageSrc && (
      <div class="card__media">
        <ZoomableImage src={imageSrc} alt={`${title} preview`} />
      </div>
    )
  }

  <div class="card__body">
    <h3 class="card__title">{title}</h3>
    <p class="card__desc">{description}</p>

    {
      tags.length > 0 && (
        <ul class="card__tags">
          {tags.map((t) => (
            <li class="card__tag">{t}</li>
          ))}
        </ul>
      )
    }

    {
      allLinks.length > 0 && (
        <div class="card__links">
          {allLinks.map((link) => (
            <a
              class="btn btn--outline card__link"
              href={link.url}
              target="_blank"
              rel="noopener"
            >
              {link.label} ↗
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%; /* fill the flex item so all cards match the tallest */
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .card:hover {
    border-color: var(--color-accent);
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .card__media {
    aspect-ratio: 16 / 10;
    background: var(--color-surface-2);
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease);
  }

  .card:hover .card__media img {
    transform: scale(1.04);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    flex: 1; /* grow so links sit at the bottom; keeps cards even */
  }

  .card__title {
    font-size: var(--fs-lg);
  }

  .card__desc {
    font-size: var(--fs-sm);
    font-weight: var(--fw-light);
    color: var(--color-text-muted);
    margin: 0;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-2xs);
  }

  .card__tag {
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    letter-spacing: 0.02em;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: 0.25em 0.65em;
    border-radius: var(--radius-pill);
  }

  .card__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    /* Stick buttons to the bottom of the card */
    margin-top: auto;
    padding-top: var(--space-md);
  }

  /* Smaller than the default .btn, to fit inside the card */
  .card__link {
    font-size: var(--fs-sm);
    padding: 0.5em 1em;
  }
</style>
