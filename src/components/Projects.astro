---

<section id="projects" class="projects">
  <div class="container">
    <header class="projects__header">
      <h2 class="projects__title">Projects</h2>
      <p class="projects__subtitle">A few things I've built.</p>
    </header>

    <!-- Filter pills -->
    <div class="filters" role="group" aria-label="Filter projects by category">
      {
        CATEGORIES.map((c, i) => (
          <button
            class="filter-pill"
            type="button"
            data-filter={c.value}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            {c.label}
          </button>
        ))
      }
    </div>

    <div class="projects__grid" data-grid>
      {
        projects.map((p) => {
          // Normalize to a space-separated list so filtering can match
          // any of a project's categories.
          const cats = Array.isArray(p.category) ? p.category : [p.category];
          return (
            <div class="projects__item" data-category={cats.join(" ")}>
              <ProjectCard {...p} />
            </div>
          );
        })
      }
    </div>

    <p class="projects__empty" data-empty hidden>
      No projects in this category yet.
    </p>
  </div>
</section>

<style>
  .projects {
    padding-block: var(--space-2xl);
  }

  .projects__header {
    margin-bottom: var(--space-lg);
  }

  .projects__title {
    font-size: var(--fs-2xl);
  }

  .projects__subtitle {
    margin-top: var(--space-xs);
    font-weight: var(--fw-light);
    color: var(--color-text-muted);
  }

  /* ---------- Filter pills ---------- */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .filter-pill {
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 0.65em 1.4em;
    line-height: 1;
    cursor: pointer;
    transition:
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .filter-pill:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  /* Active pill: filled pink with a soft glow */
  .filter-pill[aria-pressed="true"] {
    color: var(--color-on-accent);
    background: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-glow);
  }

  /* ---------- Horizontal scroll row ---------- */
  .projects__grid {
    display: flex;
    gap: var(--space-lg);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-block: var(--space-xs) var(--space-md);
    scrollbar-width: thin;
    scrollbar-color: var(--color-border-strong) transparent;
  }

  .projects__grid::-webkit-scrollbar {
    height: 8px;
  }
  .projects__grid::-webkit-scrollbar-track {
    background: transparent;
  }
  .projects__grid::-webkit-scrollbar-thumb {
    background: var(--color-border-strong);
    border-radius: var(--radius-pill);
  }
  .projects__grid::-webkit-scrollbar-thumb:hover {
    background: var(--color-accent);
  }

  /* Each item is a fixed-width card so the row scrolls */
  .projects__item {
    flex: 0 0 380px;
    scroll-snap-align: start;
  }

  /* Mobile: narrower cards that never exceed the screen width */
  @media (max-width: 600px) {
    .projects__item {
      flex-basis: 78vw;
      max-width: 300px;
    }
  }

  .projects__item[hidden] {
    display: none;
  }

  .projects__empty {
    color: var(--color-text-muted);
    font-weight: var(--fw-light);
  }
</style>

<script>
  // Client-side category filtering.
  const pills = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const items = document.querySelectorAll<HTMLElement>("[data-category]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");

  const applyFilter = (value: string) => {
    let visible = 0;
    items.forEach((item) => {
      // data-category may hold multiple space-separated categories.
      const cats = (item.dataset.category ?? "").split(" ");
      const match = value === "all" || cats.includes(value);
      item.hidden = !match;
      if (match) visible += 1;
    });
    if (empty) empty.hidden = visible !== 0;
  };

  pills.forEach((pill) => {
    pill.addEventListener("click", () => {
      pills.forEach((p) => p.setAttribute("aria-pressed", "false"));
      pill.setAttribute("aria-pressed", "true");
      applyFilter(pill.dataset.filter ?? "all");
    });
  });
</script>
