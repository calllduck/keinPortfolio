---

<section id="projects" class="projects">
  <div class="container">
    <header class="projects__header" data-reveal>
      <h2 class="projects__title" tabindex="-1">Projects</h2>
    </header>

    <!-- Filter pills -->
    <div class="filters" role="group" aria-label="Filter projects by category">
      {
        CATEGORIES.map((c, i) => (
          <button
            class="filter-pill"
            type="button"
            data-filter={c.value}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            <svg class="filter-pill__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {c.value === "all" && <><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></>}
              {c.value === "cyber" && <><path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z" /><path d="m8 12 3 3 5-6" /></>}
              {c.value === "software" && <path d="m8 6-6 6 6 6M16 6l6 6-6 6M14 4l-4 16" />}
              {c.value === "uiux" && <><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M9 9v11M6 6.5h.01M9 6.5h.01" /></>}
            </svg>
            {c.label}
          </button>
        ))
      }
    </div>

    <div id="projects-grid" class="projects__grid" data-grid>
      {
        projects.map((p) => {
          // Normalize to a space-separated list so filtering can match
          // any of a project's categories.
          const cats = Array.isArray(p.category) ? p.category : [p.category];
          return (
            <div class="projects__item" data-category={cats.join(" ")} data-reveal>
              <ProjectCard {...p} />
            </div>
          );
        })
      }
    </div>

    <div class="projects__more" data-more-wrapper hidden>
      <button class="btn btn--outline" type="button" data-more aria-controls="projects-grid" aria-expanded="false">More</button>
    </div>

    <button class="btn btn--outline projects__collapse" type="button" data-collapse aria-controls="projects-grid" aria-expanded="true" hidden>
      Show less <span aria-hidden="true">↑</span>
    </button>

    <p class="projects__empty" data-empty hidden>
      No projects in this category yet.
    </p>
  </div>
</section>

<style>
  .projects {
    padding-block: var(--space-2xl);
  }

  .projects__header {
    margin-bottom: var(--space-lg);
  }

  .projects__title {
    font-size: var(--fs-2xl);
  }

  .projects__subtitle {
    margin-top: var(--space-xs);
    font-weight: var(--fw-light);
    color: var(--color-text-muted);
  }

  /* ---------- Filter pills ---------- */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 0.65em 1.4em;
    line-height: 1;
    cursor: pointer;
    transition:
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .filter-pill:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .filter-pill__icon {
    width: 1.15em;
    height: 1.15em;
    flex-shrink: 0;
  }

  .filter-pill:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (max-width: 600px) {
    .filter-pill {
      font-size: var(--fs-sm);
      padding-inline: 1em;
      line-height: 1.3;
    }
  }

  /* Active pill: filled pink with a soft glow */
  .filter-pill[aria-pressed="true"] {
    color: var(--color-on-accent);
    background: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-glow);
  }

  /* ---------- Responsive project grid ---------- */
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .projects__item {
    min-width: 0;
  }

  @media (max-width: 1024px) {
    .projects__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .projects__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .projects__item[hidden] {
    display: none;
  }

  .projects__more {
    margin-top: var(--space-xl);
    text-align: center;
  }

  .projects__more[hidden] { display: none; }

  .projects__collapse { display: none; }

  @media (max-width: 600px) {
    .projects__collapse:not([hidden]) {
      display: inline-flex;
      position: fixed;
      bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
      left: 50%;
      transform: translateX(-50%);
      z-index: 40;
      min-height: 44px;
      white-space: nowrap;
      background: var(--color-surface);
      box-shadow: 0 4px 24px rgb(0 0 0 / 35%);
    }

  }

  .projects__title { scroll-margin-top: 100px; }

  .projects__empty {
    color: var(--color-text-muted);
    font-weight: var(--fw-light);
  }
</style>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const items = document.querySelectorAll<HTMLElement>("[data-category]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const more = document.querySelector<HTMLButtonElement>("[data-more]");
  const moreWrapper = document.querySelector<HTMLElement>("[data-more-wrapper]");
  const section = document.querySelector<HTMLElement>("#projects");
  const title = section?.querySelector<HTMLElement>(".projects__title");
  const collapse = section?.querySelector<HTMLButtonElement>("[data-collapse]");
  const tablet = window.matchMedia("(max-width: 1024px)");
  const mobile = window.matchMedia("(max-width: 600px)");
  let activeFilter = "all";
  let expanded = false;

  const updateCollapse = () => {
    if (!collapse || !section) return;
    const bounds = section.getBoundingClientRect();
    const middle = window.innerHeight / 2;
    collapse.hidden = !mobile.matches || !expanded || activeFilter !== "all"
      || bounds.top > middle || bounds.bottom < middle;
  };

  const applyFilter = () => {
    const limit = (mobile.matches ? 1 : tablet.matches ? 2 : 3) * 2;
    let matched = 0;
    items.forEach((item) => {
      const cats = (item.dataset.category ?? "").split(" ");
      const match = activeFilter === "all" || cats.includes(activeFilter);
      if (match) matched += 1;
      item.hidden = !match || (activeFilter === "all" && !expanded && matched > limit);
    });
    if (empty) empty.hidden = matched !== 0;
    if (moreWrapper) moreWrapper.hidden = activeFilter !== "all" || expanded || matched <= limit;
    more?.setAttribute("aria-expanded", String(expanded));
    updateCollapse();
  };

  pills.forEach((pill) => {
    pill.addEventListener("click", () => {
      pills.forEach((p) => p.setAttribute("aria-pressed", "false"));
      pill.setAttribute("aria-pressed", "true");
      activeFilter = pill.dataset.filter ?? "all";
      expanded = false;
      applyFilter();
    });
  });

  more?.addEventListener("click", () => {
    expanded = true;
    applyFilter();
  });
  collapse?.addEventListener("click", () => {
    expanded = false;
    applyFilter();
    title?.focus({ preventScroll: true });
    title?.scrollIntoView({ behavior: "instant", block: "start" });
  });
  let scrollPending = false;
  window.addEventListener("scroll", () => {
    if (scrollPending) return;
    scrollPending = true;
    requestAnimationFrame(() => {
      updateCollapse();
      scrollPending = false;
    });
  }, { passive: true });
  window.addEventListener("resize", updateCollapse);
  tablet.addEventListener("change", applyFilter);
  mobile.addEventListener("change", applyFilter);
  applyFilter();
</script>
