---
// ZoomableImage: an <img> that shows an "expand" icon on hover and
// opens a shared lightbox on click. Pairs with Lightbox.astro
// (mounted once in BaseLayout) via the [data-zoomable] attribute.
interface Props {
  src: string;
  alt?: string;
  loading?: "lazy" | "eager";
}
const { src, alt = "", loading = "lazy" } = Astro.props;
---

<button class="zoom" type="button" data-zoomable data-src={src} aria-label="Expand image">
  <img src={src} alt={alt} loading={loading} decoding="async" />
  <span class="zoom__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="18" height="18">
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"
      ></path>
    </svg>
  </span>
</button>

<style>
  .zoom {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    margin: 0;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
  }

  .zoom img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-slow) var(--ease);
  }

  .zoom:hover img {
    transform: scale(1.04);
  }

  /* Expand icon badge, appears on hover/focus */
  .zoom__icon {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    color: var(--color-on-accent);
    background: color-mix(in srgb, var(--color-bg) 55%, transparent);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .zoom:hover .zoom__icon,
  .zoom:focus-visible .zoom__icon {
    opacity: 1;
    transform: translateY(0);
  }

  .zoom:hover .zoom__icon {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .zoom img,
    .zoom__icon {
      transition: none;
    }
  }
</style>
