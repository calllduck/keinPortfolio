---
// Honors & Awards: expandable list of award cards.
// `image` is REQUIRED for every award (shown as a thumbnail on the left).
// Edit the `items` array below to add your own.
interface Award {
  title: string;
  issuer?: string;
  date: string; // e.g. "2024"
  image: string; // required, path under /public
  imageAlt?: string;
  description?: string;
}

import AchievementCard from "./AchievementCard.astro";

const base = import.meta.env.BASE_URL;
const resolveImg = (src: string) => `${base.replace(/\/$/, "")}/${src}`;

const items: Award[] = [
  {
    title: "Dean's List Award",
    date: "2025",
    image: "award1.jpeg",
    imageAlt: "Dean's List",
    description: "BINUS University",
  },
  {
    title: "1st Place, Invention Udayana UI/UX Design Competition",
    date: "2025",
    image: "award2.png",
    imageAlt: "1st Place UI/UX Invention",
    description: "Universitas Udayana",
  },
  {
    title: "1st Place, IDSC International Business Case Competition",
    date: "2025",
    image: "award3.png",
    imageAlt: "1st Place IBCC IDSC",
    description: "Universitas Airlangga",
  },
  {
    title: "1st Place, Astra Motor Business Case Competition Jakarta Region",
    date: "2025",
    image: "award5.jpeg",
    imageAlt: "1st place BCC Astra",
    description: "Astra Motor BSD",
  },
  {
    title: "1st Place, CCI Summit UI/UX Design Competition",
    date: "2024",
    image: "award4.png",
    imageAlt: "1st Place UI/UX CCI",
    description: "Telkom University",
  },
];
---

<section id="awards" class="achievements-section">
  <header>
    <h2>Honors &amp; Awards</h2>
  </header>
  <ul>
    {items.map((a) => (
      <li>
        <AchievementCard
          title={a.title}
          issuer={a.issuer ?? a.description}
          date={a.date}
          image={resolveImg(a.image)}
          imageAlt={a.imageAlt}
        />
      </li>
    ))}
  </ul>
</section>

<style>
  .achievements-section { min-width: 0; }
  header { margin-bottom: var(--space-md); }
  header h2 { font-size: clamp(1.5rem, 2.5vw, 2.5rem); }
  header p { margin-top: var(--space-xs); font-weight: var(--fw-light); }
  ul { display: flex; flex-direction: column; gap: var(--space-sm); }
  li { min-width: 0; }
</style>
