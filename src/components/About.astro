---
// About: top (hero) section.
// Left-aligned content: creative photo frame, heading, description,
// and the two CTA buttons (reusing the global .btn styles).
interface Props {
  photo?: string; // path under /public, resolved against BASE_URL
  photoAlt?: string;
  cvHref?: string;
  contactHref?: string;
}

const base = import.meta.env.BASE_URL;
const {
  photo = "me.jpg",
  photoAlt = "Portrait of Ke'in",
  cvHref = "https://drive.google.com/file/d/1NTpFuE03--S37xGRo5yA6tHSJ9lcrZ2k/view?usp=drive_link",
  contactHref = "#contact",
} = Astro.props;

const photoSrc = `${base.replace(/\/$/, "")}/${photo}`;
---

<section id="about" class="about">
  <!-- Decorative double squircle in the top-right corner (mirrors the
       one at the bottom-right of the Contact section). -->
  <div class="about__decor" aria-hidden="true">
    <span class="about__blob about__blob--a"></span>
    <span class="about__blob about__blob--b"></span>
  </div>

  <!-- Smaller double squircle in the top-left corner. -->
  <div class="about__decor about__decor--left" aria-hidden="true">
    <span class="about__blob about__blob--c"></span>
    <span class="about__blob about__blob--d"></span>
  </div>



  <div class="container about__inner" data-reveal>
    <!-- Creative photo frame -->
    <div class="photo">
      <!-- Outline squircle behind the photo; morphs on its own,
           out of sync with the main frame. -->
      <span class="photo__outline" aria-hidden="true"></span>
      <div class="photo__glow" aria-hidden="true"></div>
      <div class="photo__frame">
        <img
          class="photo__img"
          src={photoSrc}
          alt={photoAlt}
          width="320"
          height="320"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>

    <!-- Text block -->
    <div class="about__text">
      <h1 class="about__heading">
        Hi, you can call me <span class="accent">Ke'in!</span>
      </h1>
      <p class="about__desc">
        From design and development to security, I build end-to-end software solutions that transform complex ideas into reliable digital products.
      </p>
      <div class="about__actions">
        <a class="btn btn--lg btn--outline" href={cvHref} target="_blank" rel="noopener">View my CV</a>
        <a class="btn btn--lg btn--fill" href={contactHref}>Contact me</a>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    overflow: hidden; /* clips the corner decor */
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  /* Keep content above the decorative shapes */
  .about > .container {
    position: relative;
    z-index: 1;
  }

  /* ---------- Decorative double squircle (top-right corner) ---------- */
  .about__decor {
    position: absolute;
    top: 0;
    right: 0;
    width: 560px;
    height: 560px;
    pointer-events: none;
    z-index: 0;
    display: none; /* hidden on small screens */
  }

  @media (min-width: 900px) {
    .about__decor {
      display: block;
    }
  }

  .about__blob {
    position: absolute;
    border: 2px solid var(--color-accent);
    pointer-events: none;
  }

  /* Big outline squircle, pushed past the top-right corner. */
  .about__blob--a {
    width: 450px;
    height: 450px;
    right: -130px;
    top: -130px;
    opacity: 0.45;
    border-radius: 55% 45% 42% 58% / 48% 60% 40% 52%;
    animation: about-morph-a 14s ease-in-out infinite;
  }

  /* Second squircle — smaller, tight overlap, different timing + phase. */
  .about__blob--b {
    width: 420px;
    height: 420px;
    right: -130px;
    top: -130px;
    opacity: 0.22;
    border-radius: 55% 45% 42% 58% / 48% 60% 40% 52%;
    animation: about-morph-b 14s ease-in-out infinite;
  }

  /* Smaller decor in the top-left corner */
  .about__decor--left {
    right: auto;
    left: 0;
    width: 190px;
    height: 190px;
  }

  .about__blob--c {
    width: 190px;
    height: 190px;
    left: -60px;
    top: -60px;
    opacity: 0.4;
    border-radius: 42% 58% 60% 40% / 50% 45% 55% 50%;
    animation: about-morph-a 15s ease-in-out infinite;
    animation-delay: -2s;
  }

  .about__blob--d {
    width: 160px;
    height: 160px;
    left: -60px;
    top: -60px;
    opacity: 0.2;
    border-radius: 55% 45% 42% 58% / 48% 60% 40% 52%;
    animation: about-morph-b 10.5s ease-in-out infinite;
    animation-delay: -5s;
  }



  /* Morph shape AND drift position, so the two circles' gap changes
     over time and they intersect more at some points. */
  @keyframes about-morph-a {
    0%,
    100% {
      border-radius: 42% 58% 60% 40% / 50% 45% 55% 50%;
      transform: translate(0, 0);
    }
    33% {
      border-radius: 58% 42% 45% 55% / 60% 50% 50% 40%;
      transform: translate(-22px, 16px);
    }
    66% {
      border-radius: 48% 52% 55% 45% / 42% 58% 42% 58%;
      transform: translate(14px, -12px);
    }
  }

  @keyframes about-morph-b {
    0%,
    100% {
      border-radius: 55% 45% 42% 58% / 48% 60% 40% 52%;
      transform: translate(0, 0);
    }
    50% {
      border-radius: 40% 60% 58% 42% / 55% 42% 58% 45%;
      transform: translate(26px, -18px);
    }
  }

  .about__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start; /* everything left-aligned */
    gap: var(--space-xl);
    text-align: left;
  }

  /* ---------- Creative photo frame ---------- */
  .photo {
    position: relative;
    width: clamp(200px, 40vw, 300px);
    aspect-ratio: 1;
    isolation: isolate;
  }

  /* Soft pink glow behind the frame */
  .photo__glow {
    position: absolute;
    inset: -12%;
    z-index: -1;
    background: radial-gradient(
      circle at 50% 40%,
      var(--color-accent-glow),
      transparent 70%
    );
    filter: blur(6px);
  }

  /* Squircle gradient border via padding + background */
  .photo__frame {
    width: 100%;
    height: 100%;
    padding: 3px;
    /* Organic squircle that slowly, irregularly morphs over time. */
    border-radius: 32% 68% 62% 38% / 42% 38% 62% 58%;
    background: linear-gradient(
      135deg,
      var(--color-accent),
      var(--color-accent-active) 60%,
      transparent
    );
    animation: morph 16s ease-in-out infinite;
    transition: transform var(--dur-slow) var(--ease);
  }

  /* Slow, irregular blob morph: each keyframe is a different
     asymmetric squircle, so the shape drifts organically. */
  @keyframes morph {
    0%,
    100% {
      border-radius: 32% 68% 62% 38% / 42% 38% 62% 58%;
    }
    25% {
      border-radius: 58% 42% 38% 62% / 62% 58% 42% 38%;
    }
    50% {
      border-radius: 45% 55% 70% 30% / 55% 48% 52% 45%;
    }
    75% {
      border-radius: 60% 40% 48% 52% / 38% 62% 40% 60%;
    }
  }

  .photo__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
    background: var(--color-surface-2);
    display: block;
  }

  /* Subtle lift on hover (shape keeps morphing on its own) */
  .photo:hover .photo__frame {
    transform: translateY(-4px);
  }

  /* Outline squircle behind the photo. Same morphing idea but a
     different keyframe set, slower, and offset — so it never moves
     in sync with the main frame. */
  .photo__outline {
    position: absolute;
    inset: -14px;
    z-index: -1;
    border: 2px solid var(--color-accent);
    opacity: 0.5;
    border-radius: 50% 50% 42% 58% / 55% 48% 52% 45%;
    animation: morph-outline 11s ease-in-out infinite;
    animation-delay: -3s; /* start mid-cycle so it's out of phase */
  }

  @keyframes morph-outline {
    0%,
    100% {
      border-radius: 50% 50% 42% 58% / 55% 48% 52% 45%;
    }
    33% {
      border-radius: 40% 60% 55% 45% / 48% 62% 38% 52%;
    }
    66% {
      border-radius: 62% 38% 48% 52% / 40% 50% 50% 60%;
    }
  }

  /* ---------- Text ---------- */
  .about__heading {
    font-size: var(--fs-2xl);
    max-width: 20ch;
  }

  .accent {
    color: var(--color-accent);
  }

  .about__desc {
    margin-top: var(--space-md);
    font-size: var(--fs-base);
    font-weight: var(--fw-light);
    color: var(--color-text-muted);
    max-width: 68ch;
  }

  .about__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  /* ---------- Responsive: side-by-side on wider screens ---------- */
  @media (min-width: 768px) {
    .about {
      padding-block: var(--space-3xl);
    }

    .about__inner {
      flex-direction: row;
      align-items: center;
      gap: var(--space-2xl);
    }

    .photo {
      flex-shrink: 0;
      width: clamp(260px, 28vw, 340px);
    }
  }

  /* Mobile: center the photo and the text block */
  @media (max-width: 767px) {
    .about__inner {
      align-items: center;
      text-align: center;
    }

    .photo {
      align-self: center;
    }

    .about__heading,
    .about__desc {
      margin-inline: auto; /* center the width-capped text blocks */
    }

    .about__actions {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo__frame,
    .photo:hover .photo__frame,
    .photo__outline,
    .about__blob {
      animation: none;
      transition: none;
      transform: none;
    }
  }
</style>
