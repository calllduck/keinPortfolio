---
// Experience: a vertical timeline of roles / milestones.
// Edit the `items` array below to add your own experience.
interface ExperienceItem {
  category: "technical" | "community";
  role: string;
  org: string;
  period: string; // e.g. "2023 — Present"
  description?: string;
  tags?: string[];
  image?: string; // optional, path under /public
  imageAlt?: string;
}

import ZoomableImage from "./ZoomableImage.astro";

const base = import.meta.env.BASE_URL;
const resolveImg = (src?: string) =>
  src ? `${base.replace(/\/$/, "")}/${src}` : undefined;

const items: ExperienceItem[] = [
  {
    role: "Trainee of Security Manpower Training Program 2026",
    category: "technical",
    org: "NSHC, South Korea - Remote",
    period: "Aug 2026 — Sept 2026",
    description:
      "Completed an intensive cyber security program materials and validated skills through assessments, sales kits, and video creation, culminating in a hands-on Web VAPT final project.",
    tags: ["Linux", "Web & Network Security", "Cryptography", "Digital Forensics", "ICS/OT", "OSINT", "AI Security", "VAPT"],
    // Optional image: drop a file in public/ and set its name here.
    // Replace with your real photo (e.g. "exp-1.jpg"), or remove
    // these two lines to hide the image for this entry.
    image: "exp1.png",
    imageAlt: "SMT Program Indonesia 2026",
  },
  {
    role: "Freshmen Partner",
    category: "community",
    org: "BINUS University, Bandung, Onsite",
    period: "Sept 2025 — Sept 2026",
    description:
      "Mentor and assist 9 new students throughout their entire first year (12 Months) to make sure their seamless academic and social transition.",
    tags: ["Leadership", "Teamwork", "Communication"],
    image: "exp2.jpeg",
    imageAlt: "Freshmen Partner",
  },
  {
    role: "Member of Lab Curiousity",
    category: "community",
    org: "BINUS University, Bandung, Onsite",
    period: "Dec 2024 — Present",
    description:
      "A student competition community. Competed in 10+ competitions to test and expand problem-solving capabilities, while regularly attending intensive training sessions alongside fellow team members.",
    tags: ["Problem Solving", "Teamwork", "Product Ideation", "Creative Pitching", "Software Development"],
  },
  {
    role: "Freshmen Leader",
    category: "community",
    org: "BINUS University, Bandung, Onsite",
    period: "Jul 2025 — Sept 2025",
    description:
      "Lead and guide 50+ freshmen to ensure the smooth execution of the First Year Program before the first semester begins",
    tags: ["Leadership", "Teamwork", "Communication"],
    image: "exp4.jpeg",
    imageAlt: "Freshmen Leader",
  },
  // {
  //   role: "Future Maker Committee",
  //   category: "community",
  //   org: "BINUS University, Bandung, Onsite",
  //   period: "Jul 2025",
  //   description:
  //     "Handled participant registration and administrative verifications for youth innovation competition, ensuring a smooth onboarding process for high school teams.",
  //   tags: ["Management", "Communication"],
  //   image: "exp5.png",
  //   imageAlt: "Future Maker Committee",
  // },
  {
    role: "UI/UX Designer Freelance",
    category: "technical",
    org: "Masimuda Creative, Bandung, Hybrid",
    period: "May 2024 — Jun 2026",
    description:
      "Designed user-friendly interfaces and intuitive user experiences and interaction flows by creating wireframes, prototypes, and visual assets that align with user needs and brand guidelines.",
    tags: ["User Interface & Experience Design", "Systems Design"],
    image: "masimuda.jpeg",
    imageAlt: "Masimuda Creative — UI/UX Designer Freelance",
  },
  {
    role: "Graphic Designer Intern",
    category: "technical",
    org: "D2L.sg, Singapore, Remote",
    period: "Jan 2025 — Mar 2025",
    description:
      "Designed brand-aligned Instagram posts, offline posters, and visual assets to support marketing campaigns and promotional activities.",
    tags: ["Graphic Design", "Brand Design"],
    image: "",
    imageAlt: "",
  },
  {
    role: "Volunteer Tutor",
    category: "community",
    org: "Teach for Indonesia, Bandung, Onsite",
    period: "Sep 2024 — Dec 2024",
    description:
      "Volunteered at Panti Yatim Indonesia teaching basic Math and English to elementary students",
    tags: ["Teaching", "Communication", "Teamwork"],
    image: "exp8.jpeg",
    imageAlt: "Volunteer Tutor",
  },
  {
    role: "Vice Manager of Visual",
    category: "community",
    org: "From 2 with Love, Bandung, Onsite",
    period: "Aug 2023 — Apr 2024",
    description:
      "Designed brand-aligned event collateral, from social media, print, and bumper animation assets to a custom event mascot, while coordinating with visual vendors, artists, sponsors, and media partners to ensure all materials strictly met visual guidelines.",
    tags: ["Brand Design", "Illustration", "Graphic Design", "Leadership", "Teamwork"],
    image: "exp9.jpeg",
    imageAlt: "F2WL Visual",
  },
];
const groups = [
  { category: "technical", title: "Technical" },
  { category: "community", title: "Leadership & Community" },
];
---

<section id="experience" class="experience">
  <div class="container">
    <header class="experience__header" data-reveal>
      <h2 class="experience__title">Experiences</h2>
    </header>

    <div class="filters" role="group" aria-label="Filter experiences by category">
      {groups.map((group, index) => (
        <button class="filter-pill" type="button" data-experience-filter={group.category} aria-pressed={index === 0 ? "true" : "false"} aria-controls="experience-timeline">
          <svg class="filter-pill__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {group.category === "technical" ? (
              <><path d="m8 6-6 6 6 6M16 6l6 6-6 6M14 4l-4 16" /></>
            ) : (
              <><circle cx="9" cy="8" r="3" /><path d="M3 21v-3a6 6 0 0 1 12 0v3M16 5a3 3 0 0 1 0 6M21 21v-3a6 6 0 0 0-4-5.65" /></>
            )}
          </svg>
          {group.title}
        </button>
      ))}
    </div>
    <ol id="experience-timeline" class="timeline">
      {
        items.map((item) => (
          <li class="timeline__item" data-experience-category={item.category} data-reveal hidden={item.category !== "technical"}>
            <span class="timeline__dot" aria-hidden="true" />
            <div class="timeline__content">
              {item.image && (
                <div class="timeline__media">
                  <ZoomableImage
                    src={resolveImg(item.image)!}
                    alt={item.imageAlt ?? `${item.org}`}
                  />
                </div>
              )}
              <h3 class="timeline__role">{item.role}</h3>
              <span class="timeline__period">{item.period}</span>
              <p class="timeline__org">{item.org}</p>
              {item.description && (
                <p class="timeline__desc">{item.description}</p>
              )}
              {item.tags && item.tags.length > 0 && (
                <ul class="timeline__tags">
                  {item.tags.map((t) => (
                    <li class="timeline__tag">{t}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .experience {
    padding-block: var(--space-2xl);
  }

  .experience__header {
    margin-bottom: var(--space-xl);
  }

  .experience__title {
    font-size: var(--fs-2xl);
  }

  .experience__subtitle {
    margin-top: var(--space-xs);
    font-weight: var(--fw-light);
    color: var(--color-text-muted);
  }

  /* ---------- Timeline ---------- */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 0.65em 1.4em;
    line-height: 1;
    cursor: pointer;
    transition:
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .filter-pill__icon {
    width: 1.15em;
    height: 1.15em;
    flex-shrink: 0;
  }

  .filter-pill:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (max-width: 600px) {
    .filter-pill {
      font-size: var(--fs-sm);
      padding-inline: 1em;
      line-height: 1.3;
    }
  }

  .filter-pill:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .filter-pill[aria-pressed="true"] {
    color: var(--color-on-accent);
    background: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-glow);
  }

  .timeline__item[hidden] { display: none; }

  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    /* room for the line + dots on the left */
    padding-left: var(--space-lg);
  }

  /* The vertical line */
  .timeline::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 6px;
    bottom: 6px;
    width: 2px;
    background: linear-gradient(
      to bottom,
      var(--color-accent),
      var(--color-border) 90%
    );
  }

  .timeline__item {
    position: relative;
  }

  .timeline__dot {
    position: absolute;
    left: calc(-1 * var(--space-lg) + 1px);
    top: 6px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-accent-soft);
  }

  .timeline__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  /* Optional image for an entry */
  .timeline__media {
    margin-bottom: var(--space-sm);
    width: 100%;
    max-width: 240px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-2);
  }

  .timeline__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .timeline__role {
    font-size: var(--fs-lg);
  }

  /* Period sits on its own line, right under the role title */
  .timeline__period {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-accent);
    margin-top: 2px;
  }

  .timeline__org {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text);
    margin: 0;
  }

  .timeline__desc {
    font-size: var(--fs-sm);
    font-weight: var(--fw-light);
    color: var(--color-text-muted);
    margin: var(--space-2xs) 0 0;
    max-width: 68ch;
  }

  .timeline__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }

  .timeline__tag {
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: 0.25em 0.65em;
    border-radius: var(--radius-pill);
  }

  /* Mobile: smaller experience image so it doesn't fill the screen */
  @media (max-width: 600px) {
    .timeline__media {
      max-width: 170px;
    }
  }
</style>

<script>
  const experience = document.querySelector("#experience");
  const filters = experience?.querySelectorAll<HTMLButtonElement>("[data-experience-filter]");
  const entries = experience?.querySelectorAll<HTMLElement>("[data-experience-category]");

  filters?.forEach((filter) => {
    filter.addEventListener("click", () => {
      const category = filter.dataset.experienceFilter;
      filters.forEach((button) => button.setAttribute("aria-pressed", String(button === filter)));
      entries?.forEach((entry) => {
        entry.hidden = entry.dataset.experienceCategory !== category;
      });
    });
  });
</script>
