---
interface Props {
  title: string;
  issuer?: string;
  date: string;
  image?: string;
  imageAlt?: string;
  credential?: string;
}
const { title, issuer, date, image, imageAlt, credential } = Astro.props;
const Tag = credential ? "a" : image ? "button" : "div";
---

<Tag
  class="achievement"
  href={credential}
  type={Tag === "button" ? "button" : undefined}
  data-zoomable={!credential && image ? true : undefined}
  data-src={!credential ? image : undefined}
  aria-label={credential ? `View credential: ${title}` : image ? `Expand image: ${title}` : undefined}
>
  {image && <img src={image} alt={imageAlt ?? title} loading="lazy" decoding="async" />}
  <span class="achievement__text">
    <span class="achievement__title">{title}</span>
    <span class="achievement__meta">{issuer}{issuer && " · "}{date}</span>
  </span>
</Tag>

<style>
  .achievement {
    width: 100%;
    min-height: 104px;
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    color: var(--color-text);
    font: inherit;
    text-align: left;
    text-decoration: none;
    transition: border-color var(--dur) var(--ease);
  }
  a.achievement, button.achievement { cursor: pointer; }
  button.achievement { cursor: zoom-in; }
  .achievement:hover { border-color: var(--color-accent); }
  .achievement:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .achievement img {
    width: 88px;
    height: 72px;
    flex-shrink: 0;
    object-fit: contain;
    background: var(--color-surface-2);
    border-radius: var(--radius-sm);
  }
  .achievement__text { flex: 1; min-width: 0; }
  .achievement__title {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    line-height: var(--lh-snug);
    overflow-wrap: anywhere;
  }
  .achievement__meta {
    display: block;
    margin-top: var(--space-xs);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }
  @media (max-width: 480px) {
     .achievement { min-height: 84px; gap: var(--space-sm); padding: var(--space-sm); }
    .achievement img { width: 64px; height: 60px; }
  }
</style>
