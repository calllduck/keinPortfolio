---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import About from "../components/About.astro";
import Divider from "../components/Divider.astro";
import Skills from "../components/Skills.astro";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
import Certifications from "../components/Certifications.astro";
import Awards from "../components/Awards.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Kettin Portfolio" description="Personal portfolio of Kettin.">
  <span id="top"></span>
  <Navbar name="Kettin" />

  <main>
    <div id="about" class="hero-skills">
      <About photoAlt="Portrait of Ke'in" />
      <Skills />
    </div>
    <Divider />
    <Projects />
    <Divider />
    <div class="container achievements" data-reveal>
      <div class="achievements__column">
        <Certifications />
      </div>
      <div class="achievements__column achievements__column--awards">
        <Awards />
      </div>
    </div>
    <Divider />
    <Experience />
    <Divider />
    <Contact />
  </main>

  <Footer name="Kettin" />
</BaseLayout>

<style>
  .achievements {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    padding-block: var(--space-2xl);
  }

  .achievements__column {
    min-width: 0;
    padding-right: var(--space-xl);
  }

  .achievements__column--awards {
    position: relative;
    padding-right: 0;
    padding-left: var(--space-xl);
  }

  .achievements__column--awards::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(245, 61, 107, 0.45) 50%,
      transparent 100%
    );
    pointer-events: none;
  }

  @media (max-width: 800px) {
    .achievements { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
    .achievements__column { padding: 0; }
    .achievements__column--awards {
      padding-top: var(--space-xl);
    }
    .achievements__column--awards::before {
      bottom: auto;
      width: 100%;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent 0%,
        rgba(245, 61, 107, 0.45) 50%,
        transparent 100%
      );
    }
  }

  .hero-skills {
    /* Anchor to the fixed document position, rather than the sticky hero. */
    scroll-margin-top: 72px;
    position: relative;
    isolation: isolate;
  }
</style>
